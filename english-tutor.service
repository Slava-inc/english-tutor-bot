[Unit]
Description=English Tutor Telegram Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deepseekclaw
Group=deepseekclaw
WorkingDirectory=/home/deepseekclaw/projects/English tutor
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
# Keep logs next to the project, matching the deepseekclaw convention
StandardOutput=append:/home/deepseekclaw/projects/English tutor/bot.log
StandardError=append:/home/deepseekclaw/projects/English tutor/bot.log

# Security
NoNewPrivileges=true
PrivateTmp=true

# Resource limits (TTS/STT are network-bound; the DB is tiny)
LimitNOFILE=65536
MemoryMax=512M

# Environment variables - load from .env
EnvironmentFile=/home/deepseekclaw/projects/English\ tutor/.env
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target

