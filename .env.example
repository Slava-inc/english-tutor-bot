# ============================================
# ENGLISH TUTOR BOT CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================

# --- REQUIRED: Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Empty = allow everyone (multi-user mode).
ALLOWED_USER_IDS=

# --- REQUIRED: DeepSeek ---
# https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-your-actual-key-here
DEEPSEEK_MODEL=deepseek-chat

# --- Speech-to-text (whisper-proxy) ---
# Local whisper-proxy runs on port 3011 (OpenAI-compatible /v1/audio/transcriptions).
# The tutor always sends language=en and response_format=verbose_json; the proxy
# must therefore expose per-segment avg_logprob for the Level B "say it again" drill.
# Verify the running proxy with: npm run verify:stt
WHISPER_URL=http://127.0.0.1:3011/v1/audio/transcriptions
WHISPER_MODEL=small

# --- Text-to-speech ---
# Provider: 'xai' (xAI Voice) or 'google' (legacy rollback)
TTS_PROVIDER=xai

# --- Text-to-speech: xAI Voice ---
# https://console.x.ai → API Keys (note: the key is ~84 chars)
XAI_API_KEY=xai-your-actual-key-here
XAI_TTS_URL=https://api.x.ai/v1/tts
XAI_TTS_TIMEOUT_MS=60000
# British (en-GB) voices: leo | rex | eve
TTS_XAI_VOICE=leo
# BCP-47 language tag; `en-GB` is accepted by the endpoint
TTS_LANGUAGE=en-GB
# Speech speed multiplier (1.0 = normal)
TTS_SPEED=0.95
# Output codec. `opus` returns a real Ogg-Opus container, which is exactly what
# Telegram voice notes need (so no ffmpeg transcoding is required).
# Allowed: opus | mp3 | wav | pcm | ulaw | mulaw | alaw   ("ogg" is NOT valid)
TTS_CODEC=opus
# Output sample rate in Hz: 8000 | 16000 | 22050 | 24000 | 44100 | 48000
TTS_SAMPLE_RATE=24000
# Verify the live endpoint (needs ffmpeg + a running whisper-proxy for the
# intelligibility round-trip):  npm run verify:tts
# Deliver a real voice note:    npm run verify:voice

# --- Text-to-speech: Google Cloud (legacy, only if TTS_PROVIDER=google) ---
# Path to the service account JSON. For Cloud Text-to-Speech.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-speech-key.json
# British voice. F = female, M = male.
TTS_VOICE=en-GB-Neural2-F
# Optional: override default gRPC endpoint (needed for some regions)
# TTS_ENDPOINT=

# --- Storage ---
DB_PATH=./data/tutor.db
# TTS cache directory
TTS_CACHE_DIR=./data/tts-cache
# TTS cache TTL in milliseconds (7 days)
TTS_CACHE_TTL_MS=604800000

# --- Context & tuning ---
# Number of last dialog turns fed to the LLM (sliding window, §3.3)
MAX_HISTORY_TURNS=20
# Token budget for the history window (~4 chars per token); the last 6 messages
# are always kept even if the budget is exceeded
MAX_HISTORY_TOKENS=3000
# Turns after which a free-practice session auto-closes (15)
SESSION_MAX_TURNS=15
# Idle window after which an active session auto-ends, in milliseconds (4h)
SESSION_IDLE_MS=14400000

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=production
